# ---------------------------------------------------------------------------
# LinkedIn sessions
# ---------------------------------------------------------------------------
# PREFERRED: the entire `cookie:` header from a real browser request.
# Chrome -> F12 -> Network -> refresh -> click the first document request ->
# Request Headers -> cookie: -> copy the whole value.
#
# Required rather than merely nicer: LinkedIn invalidates a session when li_at
# arrives without bcookie/bscookie, its device-identity cookies.
LINKEDIN_COOKIE=

# Fallback -- two cookies only. Works briefly, then LinkedIn expires it.
LI_AT=
JSESSIONID=

# Multiple accounts -- the only way to configure a pool. Pipe-separated pairs,
# comma-separated. Additive with LI_AT/JSESSIONID above; duplicates are ignored.
#   LINKEDIN_SESSIONS=AQEDxxx|ajax:111,AQEDyyy|ajax:222
LINKEDIN_SESSIONS=

# ---------------------------------------------------------------------------
# API access control
# ---------------------------------------------------------------------------
# Comma-separated keys accepted in the `X-API-Key` header.
# Leave REQUIRE_API_KEY=false for an open demo deployment.
API_KEYS=
REQUIRE_API_KEY=false

# ---------------------------------------------------------------------------
# Rate limiting -- protects the LinkedIn account, not your server
# ---------------------------------------------------------------------------
# LinkedIn soft-blocks somewhere around 80-150 profile views/day.
# These defaults are deliberately conservative.
MAX_PROFILES_PER_HOUR=12
MAX_PROFILES_PER_DAY=80
MIN_DELAY_SECONDS=3.0
MAX_DELAY_SECONDS=9.0

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Retention is a privacy decision: this cache holds the personal data of
# everyone looked up. Keep the windows as short as you can live with.
CACHE_TTL_SECONDS=3600        # 1h  -- served as fresh, LinkedIn untouched
CACHE_STALE_MAX_SECONDS=86400 # 24h -- last-resort fallback, then deleted
CACHE_PATH=data/cache.sqlite3

# Set false to store nothing at all. Every request then goes to LinkedIn, which
# is slower and spends the daily budget faster -- the honest trade for holding
# no third-party data.
# Default is false: a fresh install stores nothing. Set true for a demo
# deployment, where it protects the LinkedIn account from repeat requests.
CACHE_ENABLED=false

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# DEMO_MODE=true serves recorded fixtures only and never calls LinkedIn.
# Useful for local dev and as a safety net for a live demo.
DEMO_MODE=false
FIXTURES_DIR=fixtures/raw
REQUEST_TIMEOUT=25.0
LOG_LEVEL=INFO

